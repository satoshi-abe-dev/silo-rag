# 個人設定（config.example.toml をコピーしたもの。ローカルLLMのURL等が入りうる）
config.toml

# 実行時に生成されるベクトルDB（ingestスクリプトで再生成可能なので追跡しない）
data/chroma_db/

# Python
__pycache__/
*.pyc
.venv/
.venv*/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS
.DS_Store

# streamlitパッケージが自動生成する、AIコーディングツール向けスキル定義
# （プロジェクトのソースではない）
.agents/

# Claude Codeの内部管理用ディレクトリ（プロジェクトのソースではない）。
# ただし運用ルール .claude/CLAUDE.md だけは例外的に追跡する。
.claude/*
!.claude/CLAUDE.md

# ユーザーの作業領域（スクリーンショット等）。プロジェクトのソースではない。
temp/

# 非公開ファイル専用フォルダー（面接想定問答集などの個人資料）。まるごとコミットしない
# （meeting-minutesプロジェクトと同じ運用）。
private/
